data/
indexes/
runs/
*.duckdb
*.sqlite

# M9b generation artifacts: explicit defense-in-depth below the broad indexes/ rule.
indexes/crud/generation/

# Scratch files written by research subagents during the design phase.
# Harvested for their findings (see README); kept out of the repo.
.research_tmp/
.venv-research/
_research_*.py
_enc_test.txt

# Derived evaluation corpus -- rebuild with scripts/build_eval_corpus.py
crud-rag-subset/eval-expanded/

# Claude Code local state and research scratch
.claude/

# Milvus Lite databases (smoke tests, local indexes)
*.db/
*-smoke.db/

# Generation artifacts may contain corpus-derived text and must never be tracked.
# Keep explicit filename and directory rules even though current caches also live below indexes/ or runs/.
quest_gt*
generated_question*
generated_answer*
generation_cache*
qg_cache*
qa_cache*
**/quest_gt*/
**/generated_questions/
**/generated_answers/
**/generation_cache/
results/quest_gt*
results/generated_question*
results/generated_answer*
results/generation_cache*
results/qg_cache*
results/qa_cache*

# Local historical document snapshot
/docs/README.legacy.md

